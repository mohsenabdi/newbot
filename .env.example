<?php
/**
 * فایل محیطی تنظیمات
 * کپی این فایل به .env و مقادیر را تنظیم کنید
 */

// تنظیمات دیتابیس
DB_HOST=localhost
DB_PORT=3306
DB_NAME=telegram_bot
DB_USER=root
DB_PASSWORD=

// توکن بوت تلگرام
TELEGRAM_BOT_TOKEN=YOUR_BOT_TOKEN_HERE

// تنظیمات Webhook
WEBHOOK_URL=https://yoursite.com/public/webhook/
WEBHOOK_SECRET=your_secret_key_here

// تنظیمات سرور
APP_ENV=production
APP_DEBUG=false
APP_URL=https://yoursite.com

// تنظیمات فایل‌ها
UPLOAD_MAX_SIZE=2147483648
PREMIUM_MAX_SIZE=4294967296
TEMP_DIR=/tmp
STORAGE_DIR=/var/www/html/storage

// تنظیمات امنیتی
ADMIN_PASSWORD=change_this_password
SESSION_TIMEOUT=3600

// تنظیمات پرداخت
ZARINPAL_MERCHANT_ID=
ZARINPAL_SANDBOX=true
ZIBAL_MERCHANT_ID=
CRYPTO_API_KEY=

// تنظیمات لاگ
LOG_LEVEL=info
LOG_FILE=/var/www/html/logs/bot.log

// تنظیمات بکاپ
BACKUP_CHANNEL_ID=
BACKUP_INTERVAL=86400
