{
  "name": "mohsenabdi/newbot",
  "description": "ربات تلگرامی پیشرفته برای آپلود، مدیریت و اشتراک‌گذاری فایل‌ها",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "guzzlehttp/guzzle": "^7.5",
    "vlucas/phpdotenv": "^5.5",
    "ext-pdo": "*",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^9.5"
  },
  "autoload": {
    "psr-4": {
      "TelegramBot\\": "src/"
    },
    "files": [
      "src/Helpers/functions.php"
    ]
  },
  "scripts": {
    "install": "php public/install.php"
  },
  "minimum-stability": "stable"
}
